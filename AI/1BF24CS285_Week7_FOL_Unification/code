# Check whether a term is a variable
def is_variable(x):
    return isinstance(x, str) and x.islower()


# Apply substitutions to a term
def substitute(term, subs):

    if is_variable(term) and term in subs:
        return substitute(subs[term], subs)

    if isinstance(term, tuple):
        return (term[0],) + tuple(
            substitute(x, subs) for x in term[1:]
        )

    return term


# Check whether a variable occurs inside a term
def occurs(var, term, subs):

    term = substitute(term, subs)

    if var == term:
        return True

    if isinstance(term, tuple):
        return any(occurs(var, x, subs) for x in term[1:])

    return False


# Unification algorithm
def unify(x, y, subs=None):

    if subs is None:
        subs = {}

    x = substitute(x, subs)
    y = substitute(y, subs)

    if x == y:
        return subs

    if is_variable(x):
        if occurs(x, y, subs):
            return None
        subs[x] = y
        return subs

    if is_variable(y):
        if occurs(y, x, subs):
            return None
        subs[y] = x
        return subs

    if isinstance(x, tuple) and isinstance(y, tuple):

        if x[0] != y[0] or len(x) != len(y):
            return None

        for a, b in zip(x[1:], y[1:]):
            subs = unify(a, b, subs)

            if subs is None:
                return None

        return subs

    return None


# Example
expr1 = ("Eats", "x", "Apple")
expr2 = ("Eats", "Riya", "y")

result = unify(expr1, expr2)

if result is not None:
    print("Unification Successful!")
    print("Substitutions:", result)
    print("Unified Expression:", substitute(expr1, result))
else:
    print("Unification Failed!")
